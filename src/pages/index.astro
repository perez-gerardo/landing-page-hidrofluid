---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Clientes from '../components/Clientes.astro';
import EquiposTaller from '../components/EquiposTaller.astro';
import tablero from '../assets/fotos/nosotros-manos.jpg';
import equipo from '../assets/fotos/nosotros-planta.jpg';
import vitrina from '../assets/hero/showroom-hero.jpg';
import slideHidraulicos from '../assets/ambiente/srv-hidraulicos.jpg';
import slideFabricacion from '../assets/ambiente/srv-fabricacion.jpg';
import slideHidrolavadoras from '../assets/ambiente/srv-hidrolavadoras.jpg';
import slideMontacargas from '../assets/ambiente/srv-montacargas.jpg';

// Portada que cambia sola cada pocos segundos (ver main.js → "Portada").
const slides = [
  { img: vitrina, alt: 'Prensas hidráulicas, pluma, gatas lagarto y gatas botella en el showroom de Hidrofluid', tag: 'Venta de equipos para taller', href: '/productos' },
  { img: slideHidraulicos, alt: 'Técnico reparando una gata de transmisión en el taller', tag: 'Mantenimiento de equipos hidráulicos', href: '/servicios/mantenimiento-preventivo-y-correctivo#hidraulicos' },
  { img: slideFabricacion, alt: 'Soldador fabricando una prensa hidráulica', tag: 'Fabricación de equipos para taller', href: '/servicios/fabricacion' },
  { img: slideHidrolavadoras, alt: 'Técnico dando mantenimiento a una hidrolavadora industrial', tag: 'Mantenimiento de hidrolavadoras', href: '/servicios/mantenimiento-preventivo-y-correctivo#hidrolavadoras' },
  { img: slideMontacargas, alt: 'Técnico revisando una estoca eléctrica en almacén', tag: 'Estocas, transpaletas y montacargas', href: '/servicios/mantenimiento-preventivo-y-correctivo#montacargas' },
];
import { fotoAmbiente, fotoServicio } from '../data/fotos';
import { schema } from '../data/schema';
import { empresa, seo, wa, confianza, serviciosHome, nosotros } from '../data/site';

const jsonLd = JSON.stringify(schema(Astro.site!));
const foto = (n: string) => fotoServicio(n) ?? fotoAmbiente(n);
---

<Layout title={seo.titulo} description={seo.descripcion} home>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

  <!-- Portada -->
  <section class="hero-vitrina on-dark" id="inicio">
    <div class="hero-slides" data-slides>
      {
        slides.map((sl, i) => (
          <Image
            class:list={['vitrina-img', 'hero-slide', { 'is-on': i === 0 }]}
            src={sl.img}
            alt={sl.alt}
            widths={[768, 1280, 1600]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}
          />
        ))
      }
    </div>
    <div class="vitrina-veil" aria-hidden="true"></div>
    <div class="wrap vitrina-inner">
      <div class="vitrina-copy reveal">
        <span class="eyebrow">{empresa.distrito}, {empresa.ciudad}</span>
        <h1>Soluciones técnicas integrales<br />para la industria</h1>
        <p class="hero-sub">Venta, mantenimiento y fabricación de equipos hidráulicos e industriales.</p>
        <div class="hero-actions">
          <a class="btn btn-accent" href={wa()} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
          <a class="btn btn-ghost-light" href="/productos">Ver equipos en venta</a>
        </div>
      </div>
    </div>
    <div class="wrap hero-dots-wrap">
      <div class="hero-dots" role="tablist" aria-label="Imágenes de portada">
        {
          slides.map((sl, i) => (
            <a class:list={['hero-dot', { 'is-on': i === 0 }]} href={sl.href} data-slide={i} aria-label={sl.tag}>
              <span class="hero-dot-bar"><span></span></span>
              <span class="hero-dot-txt">{sl.tag}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Por qué elegirnos">
    <ul class="wrap trust-list">
      {confianza.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <!-- Servicios -->
  <section class="section" id="servicios" aria-labelledby="servicios-t">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Servicios</span>
        <h2 class="h2" id="servicios-t">Lo que hacemos por tu operación</h2>
      </div>
      <div class="svc-cards">
        {
          serviciosHome.map((s) => {
            const img = foto(s.foto);
            return (
              <a class="svc-card reveal" href={s.href}>
                {img ? <Image class="svc-card-img" src={img} alt="" widths={[480, 800, 1100]} sizes="(max-width: 720px) 100vw, 50vw" /> : <span class="svc-card-img svc-card-ph" aria-hidden="true" />}
                <span class="svc-card-shade" aria-hidden="true"></span>
                <span class="svc-card-body">
                  <span class="svc-card-title">{s.titulo}</span>
                  <span class="svc-card-more"><span>{s.texto}</span></span>
                  <span class="svc-card-cta">Ver más</span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <EquiposTaller />

  <Clientes />

  <!-- Nosotros -->
  <section class="section nosotros" id="nosotros" aria-labelledby="nosotros-t">
    <div class="wrap about">
      <div class="about-media reveal">
        <Image class="about-img about-img-a" src={tablero} alt="Manos de un técnico ajustando una prensa hidráulica en el taller" widths={[480, 720, 960]} sizes="(max-width: 900px) 90vw, 45vw" />
        <Image class="about-img about-img-b" src={equipo} alt="Técnicos con casco y chaleco caminando por una planta industrial" widths={[360, 540, 720]} sizes="(max-width: 900px) 60vw, 30vw" />
        <div class="about-badge"><strong>+10</strong><span>años en la industria</span></div>
      </div>
      <div class="about-copy reveal">
        <span class="eyebrow">Nosotros</span>
        <h2 class="h2" id="nosotros-t">Más de 10 años manteniendo la industria en marcha</h2>
        <p class="lead">{nosotros.resumen}</p>
        <div class="about-cards">
          <div class="about-card"><h3>Misión</h3><p>{nosotros.mision}</p></div>
          <div class="about-card"><h3>Visión</h3><p>{nosotros.vision}</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ubicación -->
  <section class="section section-alt" id="ubicacion" aria-labelledby="ubicacion-t">
    <div class="wrap place">
      <div class="place-copy reveal">
        <span class="eyebrow">Ubicación</span>
        <h2 class="h2" id="ubicacion-t">Visítanos en {empresa.distrito}</h2>
        <address class="place-addr">
          <span>{empresa.direccion}</span>
          <span>{empresa.distrito}, {empresa.ciudad}</span>
          {empresa.telefonos.map((t) => <a href={`tel:${t.tel}`}>{t.texto}</a>)}
          <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>
        </address>
        <div class="hero-actions">
          <a class="btn btn-wa" href={wa()} target="_blank" rel="noopener">Escribir por WhatsApp</a>
          <a class="btn btn-dark" href={empresa.mapa} target="_blank" rel="noopener">Cómo llegar</a>
        </div>
      </div>
      <div class="place-map reveal">
        <iframe title={`Ubicación de Hidrofluid en ${empresa.distrito}, ${empresa.ciudad}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={empresa.mapaEmbed}></iframe>
      </div>
    </div>
  </section>
</Layout>
