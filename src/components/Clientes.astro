---
// Banner "Nuestros clientes": franja oscura con los logos en tarjetas iguales.
// Sin animación (se desliza con el dedo en móvil) para que el scroll vaya fluido.
import { Image } from 'astro:assets';
import { clientes } from '../data/site';

const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/clientes/*.png', { eager: true });
const logo = (n: string) => logos[`../assets/clientes/${n}.png`]?.default;
---

<section class="clientes on-dark" aria-labelledby="clientes-t">
  <div class="wrap">
    <h2 class="clientes-t" id="clientes-t">Nuestros clientes</h2>
  </div>
  <ul class="clientes-grid">
    {
      clientes.map((c) => {
        const l = logo(c.logo);
        return (
          <li class="cliente-card">
            {l && <Image src={l} alt={c.alt} height={80} densities={[1, 2]} loading="lazy" decoding="async" />}
          </li>
        );
      })
    }
  </ul>
</section>
