---
// Íconos Phosphor (regular) en línea: sin peticiones extra y heredan currentColor.
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import calendar from '@phosphor-icons/core/assets/regular/calendar-check.svg?raw';
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import crane from '@phosphor-icons/core/assets/regular/crane.svg?raw';
import drop from '@phosphor-icons/core/assets/regular/drop.svg?raw';
import engine from '@phosphor-icons/core/assets/regular/engine.svg?raw';
import facebook from '@phosphor-icons/core/assets/regular/facebook-logo.svg?raw';
import gear from '@phosphor-icons/core/assets/regular/gear.svg?raw';
import instagram from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import linkedin from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import pkg from '@phosphor-icons/core/assets/regular/package.svg?raw';
import shield from '@phosphor-icons/core/assets/regular/shield-check.svg?raw';
import spray from '@phosphor-icons/core/assets/regular/spray-bottle.svg?raw';
import tiktok from '@phosphor-icons/core/assets/regular/tiktok-logo.svg?raw';
import toolbox from '@phosphor-icons/core/assets/regular/toolbox.svg?raw';
import whatsapp from '@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw';
import wrench from '@phosphor-icons/core/assets/regular/wrench.svg?raw';

const icons = {
  arrowRight, calendar, caretDown, crane, drop, engine, facebook, gear, instagram, linkedin, package: pkg,
  shield, spray, tiktok, toolbox, whatsapp, wrench,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName | (string & {});
  class?: string;
}

const { name, class: className = 'ico' } = Astro.props;
const raw = icons[name as IconName];
if (!raw) throw new Error(`Ícono desconocido: ${name}`);
const svg = raw.replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${className}" `);
---

<Fragment set:html={svg} />
