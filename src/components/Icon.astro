---
// Íconos Phosphor (regular) en línea: sin peticiones extra y heredan currentColor.
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import calendar from '@phosphor-icons/core/assets/regular/calendar-check.svg?raw';
import camera from '@phosphor-icons/core/assets/regular/camera.svg?raw';
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import checkCircle from '@phosphor-icons/core/assets/regular/check-circle.svg?raw';
import circuitry from '@phosphor-icons/core/assets/regular/circuitry.svg?raw';
import crane from '@phosphor-icons/core/assets/regular/crane.svg?raw';
import drop from '@phosphor-icons/core/assets/regular/drop.svg?raw';
import engine from '@phosphor-icons/core/assets/regular/engine.svg?raw';
import envelope from '@phosphor-icons/core/assets/regular/envelope.svg?raw';
import facebook from '@phosphor-icons/core/assets/regular/facebook-logo.svg?raw';
import file from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import gear from '@phosphor-icons/core/assets/regular/gear.svg?raw';
import handshake from '@phosphor-icons/core/assets/regular/handshake.svg?raw';
import image from '@phosphor-icons/core/assets/regular/image.svg?raw';
import instagram from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import lightning from '@phosphor-icons/core/assets/regular/lightning.svg?raw';
import linkedin from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import magnifying from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import mapPin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import pkg from '@phosphor-icons/core/assets/regular/package.svg?raw';
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import pump from '@phosphor-icons/core/assets/regular/gas-pump.svg?raw';
import seal from '@phosphor-icons/core/assets/regular/seal-check.svg?raw';
import shield from '@phosphor-icons/core/assets/regular/shield-check.svg?raw';
import spray from '@phosphor-icons/core/assets/regular/spray-bottle.svg?raw';
import tiktok from '@phosphor-icons/core/assets/regular/tiktok-logo.svg?raw';
import timer from '@phosphor-icons/core/assets/regular/timer.svg?raw';
import toolbox from '@phosphor-icons/core/assets/regular/toolbox.svg?raw';
import truck from '@phosphor-icons/core/assets/regular/truck.svg?raw';
import warning from '@phosphor-icons/core/assets/regular/warning-circle.svg?raw';
import whatsapp from '@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw';
import wrench from '@phosphor-icons/core/assets/regular/wrench.svg?raw';

const icons = {
  arrowRight, calendar, camera, caretDown, check, checkCircle, circuitry, crane, drop, engine, envelope,
  facebook, file, gear, handshake, image, instagram, lightning, linkedin, magnifying, mapPin,
  package: pkg, phone, pump, seal, shield, spray, tiktok, timer, toolbox, truck, warning, whatsapp, wrench,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName | (string & {});
  class?: string;
}

const { name, class: className = 'ico' } = Astro.props;
const raw = icons[name as IconName];
if (!raw) throw new Error(`Ícono desconocido: ${name}`);
const svg = raw.replace('<svg ', `<svg aria-hidden="true" focusable="false" class="${className}" `);
---

<Fragment set:html={svg} />
